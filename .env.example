# Template for a local configuration: copy to .env and adjust.
# Every value is optional; without it the default shown here applies.
# Relative paths are relative to the folder Playshelf is started from.
# Missing folders are created at startup.
#
# This file is for running Playshelf directly with Python. With Docker Compose,
# the container sets its own paths; see docs/DEPLOYMENT.md for the settings there.

# Game library: one subfolder per game
GAMES_DIR=games

# Database, backups and thumbnails
DATA_DIR=data

# Inbox folder for new ZIP files (new games and updates)
INBOX_DIR=inbox

# Address the web server binds to (0.0.0.0 = reachable from the whole network)
HOST=127.0.0.1

# Web server port
PORT=8000

# Maximum size of an uploaded ZIP archive in MB
MAX_UPLOAD_MB=4096

# Maximum size of an archive's extracted content in MB (protection against zip bombs)
MAX_EXTRACTED_MB=8192

# Import from link: also allow download links to addresses in the local network
URL_IMPORT_PRIVATE_NETWORKS=false

# Old versions kept per game after an update (in DATA_DIR/backups/<game>/<version>);
# older ones are deleted
KEEP_BACKUPS=3

# Inbox folder: check every this many seconds (0 = off)
INBOX_POLL_SECONDS=5

# A ZIP file must stay unchanged this many seconds before it is imported
INBOX_SETTLE_SECONDS=10

# Online update check: check each game with an update link about every this many hours
# (0 = only by hand)
UPDATE_CHECK_HOURS=24

# Offer the adult game sites F95Zone and TFGames as sources and check them for updates
ADULT_SOURCES=false

# Interface language: en, de, or auto = the browser's language (English if it is neither)
UI_LANGUAGE=auto

# Sign-in: accounts = every person signs in with their own account (the first
# start asks for the admin account), none = no login, everyone acts as the admin
AUTH=accounts

# Only when upgrading from a version with a single password: the old hash becomes
# the password of the admin account "admin" on the first start, then it is ignored
PASSWORD_HASH=
