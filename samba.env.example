# SMB accounts for the Playshelf inbox share (compose.samba.yml).
# Copy to samba.env and add one line per Playshelf user who should drop ZIP
# files over the network:
#
#   ACCOUNT_<Playshelf user name>=<SMB password>
#
# The name must match the Playshelf account exactly (lower case); that user
# then sees only their own inbox folder. Use letters, digits and "_" in the
# name, and a password without spaces. These are separate from the Playshelf
# sign-in passwords.

ACCOUNT_alice=change-me
